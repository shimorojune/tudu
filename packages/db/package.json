{
  "name": "@tudu/db",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3"
  }
}
