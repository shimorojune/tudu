# Optional local dev overrides — not required for the desktop app.
# End users configure Jira in the app via Settings on first launch.
#
# JIRA_BASE_URL=https://your-jira.example.com
# JIRA_USERNAME=your.username
# JIRA_API_TOKEN=your-password-or-token
# JIRA_TYPE=server
# NODE_TLS_REJECT_UNAUTHORIZED=0
# PORT=3456
