# Server
PORT=3456
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3456
# Prod example: https://tudu.rraj.dev,https://tudu.ezdev.net,tauri://localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost
JIRA_TOKEN_ENCRYPTION_KEY=change-me-32-byte-jira-key-00000

# TypeSafe Jev (Quick Add project and bucket suggestions)
TYPESAFE_API_KEY=

# Task description attachments (local default: filesystem, no Docker)
ATTACHMENT_STORAGE=filesystem
# ATTACHMENT_FS_ROOT=apps/server/.data/attachments
ATTACHMENT_MAX_BYTES=5242880
# S3-compatible attachments (Neon object storage or MinIO; set ATTACHMENT_STORAGE=minio)
# Neon console uses AWS_* names; server reads S3_* below.
# S3_ENDPOINT=https://your-branch.storage.region.aws.neon.tech
# S3_REGION=ap-southeast-1
# S3_BUCKET=assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Web push (Firebase Cloud Messaging). Server: full service account JSON on one line.
# FCM_SERVICE_ACCOUNT_JSON=
# Client: Firebase Web app config (Project settings → Your apps → Web).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# Client (web + desktop)
VITE_API_URL=http://localhost:3456
# PostHog (US Cloud; same project key for client and server)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Desktop OTA (server proxies private GitHub release assets)
UPDATES_GITHUB_TOKEN=
UPDATES_GITHUB_REPO=eGainDev/tudu
UPDATES_PUBLIC_BASE_URL=https://api.tudu.rraj.dev
# production (default). Optional staging: latest GitHub prerelease tagged tudu-*
# UPDATES_RELEASE_CHANNEL=staging

# Background notification jobs (JIRA poll, reminders, version alerts). Set false to disable.
NOTIFICATION_JOBS_ENABLED=true

# Dev test users (pnpm db:seed, never in production):
#   testuser@egain.com / egain@123
#   marcus@egain.com / egain@123  (manager of testuser)
#   priya@egain.com / egain@123   (report of testuser)
