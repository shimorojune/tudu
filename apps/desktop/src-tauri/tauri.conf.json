{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tudu",
  "version": "0.27.0",
  "identifier": "com.tudu",
  "mainBinaryName": "Tudu",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tudu",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true
      },
      {
        "label": "quick-add",
        "title": "Quick Add",
        "url": "quick-add.html",
        "width": 528,
        "height": 212,
        "resizable": false,
        "center": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "bundleName": "Tudu",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxOUM5NDhEMjBERDFCRjUKUldUMUc5MGdqWlNjSWJQRmJub0hNSk5rcEEwS3VJRDVtSmdWbnF2VHVzQW1UcG1lajRlVG82RG8K",
      "endpoints": [
        "https://api.tudu.rraj.dev/updates/latest.json"
      ]
    }
  }
}
