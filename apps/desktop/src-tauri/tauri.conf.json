{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tudu",
  "mainBinaryName": "Tudu",
  "version": "../../../package.json",
  "identifier": "net.ezdev.tudu",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "web",
          "description": "Tudu on the web, in the app's windows: the app's own commands, and dragging the window by the top bar (and the note window by its bar and corner).",
          "windows": ["main", "floating", "menubar", "note"],
          "remote": {
            "urls": ["https://tudu.ezdev.net/*"]
          },
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-start-resize-dragging",
            "allow-app-info",
            "allow-set-signed-in",
            "allow-set-badge",
            "allow-open-external",
            "allow-save-download",
            "allow-show-main",
            "allow-hide-floating",
            "allow-summon",
            "allow-hide-menubar",
            "allow-quit",
            "allow-update-check",
            "allow-update-install",
            "allow-update-status",
            "allow-this-mac",
            "allow-set-open-at-login",
            "allow-open-login-items",
            "allow-set-dock",
            "allow-open-note",
            "allow-note-state",
            "allow-set-note-pinned",
            "allow-set-note-expanded",
            "allow-open-in-notebook",
            "allow-hide-note"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "Tudu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxOUM5NDhEMjBERDFCRjUKUldUMUc5MGdqWlNjSWJQRmJub0hNSk5rcEEwS3VJRDVtSmdWbnF2VHVzQW1UcG1lajRlVG82RG8K",
      "endpoints": ["https://api.tudu.ezdev.net/updates/latest.json"]
    }
  }
}
