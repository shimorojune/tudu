{
  "productName": "Tudu Test",
  "mainBinaryName": "Tudu Test",
  "identifier": "net.ezdev.tudu.test",
  "bundle": {
    "targets": ["app"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://localhost:3456/updates/latest.json"],
      "dangerousInsecureTransportProtocol": true
    }
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "web",
          "description": "Tudu on the web, in the app's windows: the app's own commands, and dragging the window by the top bar.",
          "windows": ["main", "floating"],
          "remote": {
            "urls": ["http://localhost:*/*"]
          },
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "allow-app-info",
            "allow-set-signed-in",
            "allow-set-badge",
            "allow-open-external",
            "allow-save-download",
            "allow-show-main",
            "allow-hide-floating",
            "allow-update-check",
            "allow-update-install",
            "allow-control-reply"
          ]
        }
      ]
    }
  }
}
