{
  "productName": "Tudu Staging",
  "mainBinaryName": "Tudu Staging",
  "identifier": "net.ezdev.tudu.staging",
  "plugins": {
    "updater": {
      "endpoints": ["https://api.staging.tudu.ezdev.net/updates/latest.json"]
    }
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "web",
          "description": "Tudu on the web, in the app's windows: the app's own commands, and dragging the window by the top bar (and the note window by its bar).",
          "windows": ["main", "floating", "menubar", "note"],
          "remote": {
            "urls": ["https://staging.tudu.ezdev.net/*"]
          },
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-start-resize-dragging",
            "allow-app-info",
            "allow-set-signed-in",
            "allow-set-badge",
            "allow-set-tick",
            "allow-open-external",
            "allow-save-download",
            "allow-show-main",
            "allow-hide-floating",
            "allow-summon",
            "allow-summon-with",
            "allow-quick-add-seed",
            "allow-hide-menubar",
            "allow-quit",
            "allow-update-check",
            "allow-update-install",
            "allow-update-status",
            "allow-this-mac",
            "allow-set-open-at-login",
            "allow-open-login-items",
            "allow-set-dock",
            "allow-set-appearance",
            "allow-open-note",
            "allow-note-state",
            "allow-set-note-pinned",
            "allow-set-note-expanded",
            "allow-open-in-notebook",
            "allow-hide-note",
            "allow-note-resize-begin",
            "allow-note-resize-to",
            "allow-notify-permission",
            "allow-notify-status",
            "allow-notify-nudge",
            "allow-open-notification-settings"
          ]
        }
      ]
    }
  }
}
