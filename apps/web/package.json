{
  "name": "@tudu/web",
  "version": "0.35.0",
  "description": "Tudu web app shell",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "build": "pnpm --filter @tudu/shared build && node scripts/generate-pwa-icons.mjs && node scripts/generate-firebase-messaging-sw.mjs && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tudu/shared": "workspace:*",
    "@tudu/store": "workspace:*",
    "@tudu/ui": "workspace:*",
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
