{
  "name": "@tudu/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "migrate": "node --import tsx src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config auth.config.ts --output ../../packages/db/src/auth-schema.ts -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@hono/node-server": "^2.1.5",
    "@tudu/core": "workspace:^",
    "@tudu/db": "workspace:^",
    "better-auth": "^1.7.12",
    "hono": "^4.13.13",
    "resend": "^6.34.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
