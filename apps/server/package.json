{
  "name": "@tudu/server",
  "version": "0.29.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch src/index.ts",
    "build": "pnpm --filter @tudu/shared build && pnpm --filter @tudu/db build && tsc",
    "start": "node dist/index.js",
    "db:seed": "NODE_OPTIONS='--conditions=development' tsx scripts/seed-test-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.7.6",
    "@tudu/db": "workspace:*",
    "@tudu/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.8.3",
    "posthog-node": "^5.52.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
