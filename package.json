{
  "name": "tudu",
  "version": "2.0.0",
  "private": true,
  "description": "Tudu monorepo — desktop app and server",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @tudu/server --filter @tudu/desktop run dev",
    "dev:desktop": "pnpm --filter @tudu/desktop dev",
    "dev:server": "pnpm --filter @tudu/server dev",
    "build": "pnpm -r build",
    "tauri:build": "pnpm --filter @tudu/desktop tauri:build"
  },
  "engines": {
    "node": ">=20"
  }
}
