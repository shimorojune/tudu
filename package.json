{
  "name": "tudu",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "description": "Tudu: a calm day planner. Web app, macOS app and API.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && pnpm lint:copy && prettier --check .",
    "lint:copy": "node scripts/lint-copy.mjs && node scripts/check-light-tokens.mjs && node scripts/less-motion.mjs --check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:status": "node scripts/test-status.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "desktop:dev": "pnpm --filter @tudu/desktop dev",
    "desktop:build": "pnpm --filter @tudu/desktop build",
    "e2e:mac": "node scripts/e2e-mac.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
