{
  "name": "tudu",
  "version": "0.26.0",
  "private": true,
  "description": "Tudu monorepo: desktop app, web app, and server",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @tudu/server --filter @tudu/web run dev",
    "dev:all": "pnpm --parallel --filter @tudu/server --filter @tudu/desktop --filter @tudu/web run dev",
    "dev:desktop": "pnpm --filter @tudu/desktop dev",
    "dev:web": "pnpm --filter @tudu/web dev",
    "dev:server": "pnpm --filter @tudu/server dev",
    "build": "pnpm -r build",
    "tauri:build": "pnpm --filter @tudu/desktop tauri:build",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config apps/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config apps/e2e/playwright.config.ts",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "db:generate": "pnpm --filter @tudu/db db:generate",
    "db:migrate": "pnpm --filter @tudu/db db:migrate",
    "db:push": "pnpm --filter @tudu/db db:push",
    "db:seed": "pnpm --filter @tudu/server db:seed",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-transform": "1.12.1",
      "prosemirror-model": "1.25.11",
      "prosemirror-view": "1.42.3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^24.2.7",
    "vitest": "^5.0.0",
    "@playwright/test": "^1.55.0"
  }
}
